<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <!-- LangVersion=latest resolves to C# 14 on .NET 10 -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Repository metadata — populated per-project via AssemblyInfo conventions -->
    <Authors>Christopher Monney</Authors>
    <Company>Christopher Monney</Company>
    <Copyright>Copyright (c) Christopher Monney</Copyright>
    <RepositoryUrl>https://github.com/cmonney/zero-downtime-migration-toolkit</RepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

</Project>
