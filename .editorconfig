root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,xml}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# -----------------------------------------------------------------------
# .NET coding conventions
# -----------------------------------------------------------------------

[*.cs]
# Prefer file-scoped namespaces (C# 10+)
csharp_style_namespace_declarations = file_scoped:warning

# Prefer expression bodies where they add clarity
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion

# var preferences
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Braces
csharp_prefer_braces = true:warning

# Null-checking
dotnet_style_null_propagation = true:warning
dotnet_style_coalesce_expression = true:warning

# Naming: interfaces start with I
dotnet_naming_rule.interface_should_be_begins_with_i.severity = warning
dotnet_naming_rule.interface_should_be_begins_with_i.symbols = interface
dotnet_naming_rule.interface_should_be_begins_with_i.style = begins_with_i
dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

# Unused imports
dotnet_diagnostic.IDE0005.severity = warning

# Unnecessary using directives
dotnet_diagnostic.CS8019.severity = warning

# Note: there is no built-in Roslyn analyser that enforces UK spellings in
# prose comments. The .editorconfig spell-checker integration (cspell, vale)
# is configured separately in .cspell.json if contributors install the
# matching VS Code extension. This file enforces only code style.
